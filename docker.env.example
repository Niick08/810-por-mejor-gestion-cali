# Copiar como docker.env y cambiar las claves. docker.env NO se sube a git.
DB_PASSWORD=cambia-esta-clave
GEOSERVER_PASSWORD=cambia-esta-clave-tambien
SECRET_KEY=un-texto-largo-y-aleatorio
# 1 = muestra los usuarios de prueba y permite simular la ubicación del portero (solo para presentar)
MODO_DEMO=1
# Puertos en el equipo (cámbialos si ya están ocupados)
APP_PORT=8085
GEOSERVER_PORT=8086
DB_PORT=5433
URL_PUBLICA=http://localhost:8085
# Geocodificador propio. En el Lenovo: http://host.docker.internal/api · en otro equipo: http://100.109.154.10/api
GEOCODIFICADOR_URL=http://100.109.154.10/api
